# ==============================================================================
# SMYL GLOBAL — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local custom development.
# 2. Never commit '.env' or real API credentials to source control.
# 3. All keys below are development placeholders.
# ==============================================================================

# API & Gateway Configuration
API_BASE_URL=https://api-dev.smylglobal.com
API_VERSION=v1
APP_ENVIRONMENT=development

# Payment Sandbox Provider (Mock / Development Integration)
# Note: Production payment uses secure server-side webhook signing
PAYMENT_GATEWAY_KEY=pk_test_sample_placeholder_smyl
PAYMENT_CURRENCY=INR
ESCROW_ACCOUNT_ID=escrow_trust_act_sample_01

# Mapping & Geo-Routing Services
MAPS_API_KEY=sample_maps_api_key_placeholder

# SMS & Identity Verification (OTP)
SMS_OTP_PROVIDER_KEY=sample_sms_otp_key_placeholder
KYC_VERIFICATION_SERVICE_KEY=sample_kyc_service_key_placeholder

# Operational Logging & Telemetry
ENABLE_DEBUG_LOGS=true
ENABLE_DEMO_ROLE_SWITCHER=true
